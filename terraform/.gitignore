# Terraform working directory
.terraform/

# State files — always manage remotely, never commit
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files that may contain secrets
*.tfvars
!*.tfvars.example

# Plan output files
*.tfplan
tfplan

# Crash logs
crash.log
crash.*.log

# Override files (local dev overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json
